# Copie este conteúdo para os "Secrets" do app no Streamlit Community Cloud
# (Settings > Secrets). NÃO publique o arquivo com os valores reais no GitHub.

# Senha do painel de resultados (abrir o app com ?admin=1 no final do link)
senha_admin = "troque-esta-senha"

# Link da planilha do Google (compartilhe-a com o client_email abaixo como Editor)
planilha_url = "https://docs.google.com/spreadsheets/d/COLE_AQUI_O_ID/edit"

# Chave da conta de serviço (arquivo .json baixado do Google Cloud), campo por campo
[gcp_service_account]
type = "service_account"
project_id = "seu-projeto"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "teste-usabilidade@seu-projeto.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
universe_domain = "googleapis.com"
